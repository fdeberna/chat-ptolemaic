{
  "model_config_path": "configs/model_config.json",
  "train_data_path": "data/corpus_general_training",
  "val_data_path": "data/corpus_general_training",
  "tokenizer_path": "data/nanogpt/tokenizer/tokenizer.json",
  "cache_dir": "data/nanogpt/streams",
  "cache_name": "general_pretrain",
  "seed": 1337,
  "num_workers": 0,
  "force_rebuild_streams": false,
  "include_remainder": false,
  "batch_size": 4,
