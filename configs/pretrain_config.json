  "max_iters": 300000,
  "learning_rate": 0.0002,
  "min_lr": 0.00002,
  "lr_schedule": "cosine",
  "warmup_iters": 2000,
  "lr_decay_iters": 300000,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "adam_eps": 1e-08,
  "grad_clip": 1.0,
  "eval_interval": 400,
  "eval_iters": 200,
  "log_interval": 100,
  "checkpoint_interval": 2000,
  "runs_dir": "runs",
  "sample_prompt": "Explain why the planets move backwards in the sky",
  "sample_max_new_tokens": 120,
  "sample_temperature": 0.8,
  "sample_top_k": 50,
  "checkpoint_dir": "checkpoints",
  "checkpoint_name": "pretrain.pt",
  "device": "cuda",
  "dtype": "bfloat16",
  "compile": true
}
